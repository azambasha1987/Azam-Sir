# Force Linux LF line endings for all shell scripts and linux configuration files
*.sh text eol=lf
*.sql text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
*.cfg text eol=lf

# Batch and PowerShell files keep CRLF for Windows
*.bat text eol=crlf
*.ps1 text eol=crlf
